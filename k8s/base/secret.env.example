# 복사해서 사용:  cp k8s/secret.env.example k8s/secret.env
#
# secret.env 는 .gitignore 되어 있다. 절대 커밋하지 말 것.
# kustomization.yaml 의 secretGenerator 가 이 파일에서 Secret 을 만든다.
#
# 아래는 로컬 kind 클러스터용 값이다. 실제 배포에서는:
#   - 이 방식(로컬 파일) 대신 Sealed Secrets / External Secrets Operator / SOPS 사용
#   - 값은 비밀번호 관리자에서 가져올 것

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=alimi
MYSQL_USER=alimi
MYSQL_PASSWORD=alimi

# SMTP (alimi.notification.email.transport=smtp 로 바꿀 때만 필요)
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
