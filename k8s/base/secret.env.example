# 복사해서 사용:  cp k8s/secret.env.example k8s/secret.env
#
# secret.env 는 .gitignore 되어 있다. 절대 커밋하지 말 것.
# kustomization.yaml 의 secretGenerator 가 이 파일에서 Secret 을 만든다.
#
# 아래는 로컬 kind 클러스터용 값이다. 실제 배포에서는:
#   - 이 방식(로컬 파일) 대신 Sealed Secrets / External Secrets Operator / SOPS 사용
#   - 값은 비밀번호 관리자에서 가져올 것

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=alimi
MYSQL_USER=alimi
MYSQL_PASSWORD=alimi

# SMTP (alimi.notification.email.transport=smtp 로 바꿀 때만 필요)
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# ── 도메인 / TLS (라즈베리파이 오버레이 전용) ──────────────────────────
# cert-renew CronJob 이 Let's Encrypt 인증서를 DNS-01 로 받는 데 쓴다.
#   DUCKDNS_SUBDOMAIN : "alimi-example" 처럼 .duckdns.org 를 뺀 앞부분만
#   DUCKDNS_TOKEN     : duckdns.org 로그인 후 상단에 보이는 토큰
#   ACME_EMAIL        : 만료 임박 알림을 받을 주소
# ⚠️ k8s/overlays/pi/ingress.yaml 의 host 두 곳도 같은 도메인으로 바꿔야 한다.
DUCKDNS_SUBDOMAIN=alimi-example
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000
ACME_EMAIL=you@example.com

# ── 구글 OAuth (app-api 전용) ─────────────────────────────────────────
# console.cloud.google.com → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID
# 승인된 리다이렉트 URI 에 아래를 등록한다 (경로에 /api/ 가 붙는 이유는 SecurityConfig 주석 참고):
#   https://<도메인>/api/login/oauth2/code/google
#   http://localhost:8080/api/login/oauth2/code/google   (로컬 개발용. http 예외는 localhost 뿐)
# ⚠️ k8s 프로파일에서는 이 값이 비면 앱이 기동에 실패한다 (application-k8s.yml).
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
